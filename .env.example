# Environment Configuration Example for Wakko Pasta Süsleri

NODE_ENV=development
PORT=4000

# Database (PostgreSQL Container)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/wakkopastasusleri_db?schema=public

# Cache (Redis Container)
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO S3 Compatible)
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=wakkopastasusleri-assets

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-wakkopastasusleri-2026!
JWT_EXPIRES_IN=7d
JWT_ADMIN_SECRET=super-secret-admin-jwt-key-wakkopastasusleri-2026!

# App URLs
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
